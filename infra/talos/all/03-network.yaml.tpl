# Was generated by talhelper from `networkInterfaces:`. The NIC is selected by driver,
# which works on both i440fx (ens18) and q35 (enp*) machine types.
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("virtio_net", link.driver)
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
addresses:
  - address: {{ .Node.IP }}/24
routes:
  - gateway: 192.168.1.1
